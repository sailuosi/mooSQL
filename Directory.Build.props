<Project>
  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <PackageIcon>bitbug_favicon.png</PackageIcon>
    <LangVersion>12</LangVersion>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <VersionPrefix>8.2.1.9</VersionPrefix>
    <!-- 统一输出到仓库根 release/，任意深度子项目均可正确解析 -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)release</PackageOutputPath>
  </PropertyGroup>

  <!-- 使用 MSBuildThisFileDirectory，避免 provides/* 等两层目录下 ../packfile 失效 -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)packfile\bitbug_favicon.png" Visible="false" Pack="true">
      <PackagePath></PackagePath>
    </None>
    <None Include="$(MSBuildThisFileDirectory)packfile\readme.md" Link="readme.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>